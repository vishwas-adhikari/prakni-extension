{
  "manifest_version": 3,
  "name": "Prakni",
  "version": "1.1.0",
  "description": "Prakni — privacy-first phishing warning that runs locally inside webmail.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/prakni_logo_nobg.png",
      "48": "icons/prakni_logo_nobg.png",
      "128": "icons/prakni_logo_nobg.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content_gmail.js"]
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": ["content_outlook.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["storage", "alarms"],
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/prakni_logo_nobg.png",
    "48": "icons/prakni_logo_nobg.png",
    "128": "icons/prakni_logo_nobg.png"
  }
}