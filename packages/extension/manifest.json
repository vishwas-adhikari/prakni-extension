{
  "manifest_version": 3,
  "name": "Cred Mail",
  "version": "0.0.0",
  "description": "Privacy-first phishing warning that runs locally inside webmail.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content_gmail.js"]
    }
  ],
  "permissions": ["storage", "alarms"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
