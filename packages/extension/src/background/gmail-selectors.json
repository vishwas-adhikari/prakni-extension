{
  "sender": [".gD", ".go span[email]", "span.gD[email]", "h3.iw span[email]"],
  "subject": ["h2.hP", ".ha h2", "[data-thread-perm-id] h2"],
  "body": [".a3s", ".ii.gt", "div[data-message-id] .a3s"],
  "links": [".a3s a[href]", ".ii.gt a[href]"],
  "row": {
    "container": ".zA",
    "senderName": [".yX", ".zF", ".bA4", "span[email]"],
    "senderEmail": ["email", "data-hovercard-id"],
    "subject": [".bog", ".bqe", ".y6 span"],
    "threadIdAttrs": ["id", "data-legacy-thread-id"]
  },
  "outlook": {
    "container": [
      "[data-test-id='mailMessageBodyContainer']",
      ".ReadingPaneContainer",
      "[aria-label='Email message']"
    ],
    "body": [
      "[data-test-id='mailMessageBodyContainer']",
      ".BodyFragment",
      "div[aria-label='Message body']",
      "div[role='document']"
    ],
    "subjectNote": "Subject CSS selectors below are tried inside the reading-pane scope first; parser.ts falls back to document.title (split on ' - ') because Outlook's subject can be a plain React span with no selector.",
    "subject": [
      "[id$='_SUBJECT']",
      "[role='heading'][aria-level='3']",
      "[role='heading'][aria-level='2']"
    ],
    "inboxList": [
      "[aria-label='Message list']",
      ".customScrollBar"
    ],
    "inboxRow": [
      "div[role='option']",
      "div[role='row']"
    ]
  }
}